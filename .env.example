# Free tier — get your key from https://console.groq.com/keys
# Valid keys start with "gsk_"
GROQ_API_KEY=your_groq_api_key_here

# Optional — defaults to llama-3.3-70b-versatile (free)
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.1-8b-instant

# Backend server port — defaults to 8787 (local dev only)
PORT=8787

# Frontend API proxy target for local dev (optional)
# VITE_API_PROXY=http://localhost:8787

# Vercel: set GROQ_API_KEY in Project Settings → Environment Variables.
# Leave VITE_API_URL unset — frontend calls /api on the same domain.
