# Free tier — get your key from https://console.groq.com/keys
# Valid keys start with "gsk_"
GROQ_API_KEY=your_groq_api_key_here

# Optional — defaults to llama-3.3-70b-versatile (free)
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.1-8b-instant

# Server port — defaults to 8787 (local Express dev only)
PORT=8787

# Vercel deployment: set GROQ_API_KEY in Vercel Project Settings → Environment Variables.
# Do not set VITE_API_URL — the frontend calls /api on the same domain.
