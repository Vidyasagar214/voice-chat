{
  "name": "voiceflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w voiceflow-frontend",
    "dev:backend": "npm run dev -w voiceflow-backend",
    "dev:all": "concurrently -n api,web -c blue,green \"npm run dev -w voiceflow-backend\" \"npm run dev -w voiceflow-frontend\"",
    "build": "npm run build -w voiceflow-frontend",
    "build:frontend": "npm run build -w voiceflow-frontend",
    "build:backend": "npm run typecheck -w voiceflow-backend",
    "start": "npm run start -w voiceflow-backend",
    "lint": "npm run lint -w voiceflow-frontend",
    "typecheck": "npm run typecheck -w voiceflow-backend && tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@vercel/node": "^5.8.14",
    "concurrently": "^9.1.2"
  }
}
